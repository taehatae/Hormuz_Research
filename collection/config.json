{
  "input_csv": "hormuz_2026_data/05_extraction_candidates_v2.csv",
  "output_dir": "hormuz_2026_data/body_collection_v3",
  "input_columns": [
    "article_id", "url", "domain", "title", "published_date",
    "nc_word_count", "nc_content_snippet", "nc_paid_content",
    "nc_country", "nc_source_name", "nc_published_date_precision"
  ],
  "date_column": "published_date",
  "date_timezone_assumption": "UTC",
  "research_period": {"start": "2026-01-01", "end": "2026-08-31"},

  "excluded_domains": [
    "wn.com", "msn.com", "yahoo.com", "newsbreak.com", "headtopics.com",
    "ground.news", "dailyhunt.in", "custommapposter.com", "news-pravda.com", "biztoc.com"
  ],

  "sampling": {
    "target_success_total": 50000,
    "random_seed": 2026,
    "strata": [
      {"name": "pre_war",  "start": "2026-01-01", "end": "2026-02-27", "target": 2500,  "daily_floor": 5},
      {"name": "post_war", "start": "2026-02-28", "end": "2026-08-31", "target": 47500, "daily_floor": 20}
    ],
    "allocation_unit": "week_block",
    "block_days": 7,
    "within_block_order": "daily_floor_first_then_block_shuffle",
    "shortfall_fill": ["same_block_other_days", "nearest_block_alternating"],
    "nearest_block_previous_first": true,
    "domain_cap_share": 0.01,
    "domain_cap_unit": "host_without_www",
    "domain_key_strip_www": true
  },

  "plan_report": {
    "low_headroom_ratio": 3.0,
    "domain_cap_warn_fraction": 0.75,
    "success_rate_scenarios": [0.3, 0.5, 0.7]
  },

  "fetch": {
    "user_agent": "HormuzNewsResearchBot/0.3 (academic text-mining research; non-commercial)",
    "per_domain_min_interval_sec": 2.0,
    "rate_limit_unit": "registrable_domain",
    "tldextract_use_bundled_suffix_list_only": true,
    "max_workers": 16,
    "connect_timeout_sec": 10,
    "read_timeout_sec": 20,
    "max_retries": 2,
    "backoff_base_sec": 2.0,
    "retry_on_status": [429, 500, 502, 503, 504],
    "robots_timeout_sec": 10,
    "domain_consecutive_block_limit": 5,
    "blocked_failure_reasons": ["http_401", "http_403", "http_451", "http_429", "cloudflare_challenge"],
    "domain_skip_failure_reasons": ["http_403", "cloudflare_challenge", "paywall"],
    "save_html_gzip": true,
    "html_dir": "html",
    "max_html_bytes": 15000000,
    "accept_header": "text/html,application/xhtml+xml;q=0.9,*/*;q=0.5",
    "robots_user_agent_token": "HormuzNewsResearchBot"
  },

  "extract": {
    "extractor": "trafilatura",
    "include_comments": false,
    "favor_precision": true,
    "with_metadata": true,
    "min_body_words": 100,
    "required_language": "en",
    "min_words_ratio_to_nc": 0.5,
    "code_token_density_per_100_words": 5.0,
    "non_article_path_patterns": ["/topic/", "/tag/", "/tags/", "/category/"],
    "live_path_patterns": ["/live/", "/live-updates/", "/liveblog/", "/live-blog/", "/live-news/", "-live-updates-", "-liveblog-", "-live-blog-"],
    "title_overlap_head_words": 100,
    "over_words_flag": 10000,
    "required_keyword": "hormuz",
    "snippet_match_chars": 120,
    "snippet_window_step": 10,
    "language_detect_chars": 3000,
    "boilerplate_share_threshold": 0.5,
    "paywall_patterns": [
      "subscribe to (continue|read)", "to continue reading", "already a subscriber", "subscribers? only",
      "for subscribers", "subscription required", "become a (member|subscriber)", "unlock (this|full) (article|story)",
      "this (article|content) is (for|available to) (paid )?(subscribers|members)", "start your (free )?trial",
      "you have reached your (free )?(article )?limit", "read the full (article|story) (with|by subscribing)"
    ],
    "boilerplate_patterns": [
      "\\bcookies?\\b", "privacy policy", "accept all", "manage (your )?(preferences|consent)",
      "sign in", "log ?in", "create (a|an) (free )?account", "register (now|for free|to)", "enable javascript",
      "ad ?blocker", "are you a robot", "verify you are human"
    ]
  },

  "gap_days": {
    "csv": "collection/collection_gap_days.csv",
    "source_notebook": "methods/hormuz_2026_news_textmining_filtered.ipynb",
    "log_marker": "결과가 많아 날짜를 분할합니다",
    "split_threshold_hits": 9000,
    "queries": {"soh": "\"Strait of Hormuz\"", "hs": "\"Hormuz Strait\""},
    "missing_estimate_window_days": 7
  },

  "postprocess": {
    "near_duplicate": {"method": "minhash", "action": "assign_group_id_only",
                       "num_perm": 128, "shingle_words": 5, "jaccard_threshold": 0.8, "seed": 2026},
    "review_domains": ["newsy-today.com", "briefingwire.com", "bitget.com", "indiavision.com",
                       "poncacitynews.com", "theava.com"],
    "review_examples_per_domain": 3,
    "top_domains_n": 30,
    "partial_body_min_words": 300,
    "partial_body_examples": 10,
    "few_articles_country_threshold": 30,
    "country_cum_shares": [0.8, 0.9],
    "country_verification": {
      "domain_coverage_share": 0.80,
      "coverage_basis": "final_sample_article_count",
      "compare_with": "nc_country",
      "method": "to_be_decided_at_stage_5",
      "generic_cctlds": ["tv", "io", "co", "me", "ai", "fm", "ly", "gg", "to", "cc", "ws", "la", "nu", "sh", "ac", "vc"],
      "non_country_tlds": ["eu", "su"],
      "cctld_to_iso2": {"uk": "GB"},
      "step3_top_n": 200,
      "wikidata_endpoint": "https://query.wikidata.org/sparql",
      "wikidata_user_agent": "HormuzNewsResearchBot/0.3 (academic text-mining research; https://github.com/taehatae/Hormuz_Research)",
      "wikidata_batch_domains": 100,
      "wikidata_url_variants_per_domain": 8,
      "wikidata_pause_sec": 2
    }
  },

  "supplement": {
    "output_dir": "hormuz_2026_data/supplement_20261108",
    "api_url": "https://v3-api.newscatcherapi.com/api/search",
    "api_key_env": "NEWSCATCHER_API_KEY",
    "dotenv_path": ".env",
    "request_body_fixed": {
      "lang": "en",
      "exclude_duplicates": true,
      "sort_by": "date",
      "page_size": 1000
    },
    "datetime_format": "%Y/%m/%d %H:%M:%S",
    "day_start_time": "00:00:00",
    "day_end_time": "23:59:59",
    "split_threshold_hits": 9000,
    "timeout_sec": 90,
    "max_retries": 5,
    "page_sleep_sec": 0.3
  },

  "runs": {
    "db": "collection.sqlite3",
    "stages": {"smoke": 100, "pilot": 2000, "main": null},
    "progress_log_every": 500,
    "dispatch_scan_limit": 300,
    "anomaly_check_after": 20,
    "anomaly_max_pre_request_skip_share": 0.8,
    "anomaly_min_fetch_ok": 1,
    "anomaly_window_records": 500,
    "anomaly_min_window_success_rate": 0.2,
    "anomaly_max_window_pre_request_skip_share": 0.8,
    "anomaly_max_consecutive_network_errors": 100,
    "anomaly_max_consecutive_runner_errors": 5,
    "min_free_disk_gb": 5,
    "disk_check_every_records": 200,
    "progress_log_interval_sec": 3600,
    "progress_log_file": "logs/main_progress.log"
  }
}
